# Server reads `.env` in this folder when you run npm scripts from server/
# Full variable list: see ../env.example at repository root.

NODE_ENV=development
PORT=5000
MONGODB_USERNAME="xxxxxxxxx"
MONGODB_PASSWORD="xxxxxxxxxxxxxx"
#MONGODB_URI=mongodb://xxxxxx:xxxxxxxx@xxxxxxxxxxxxxxxxx
MONGODB_URI=mongodb://127.0.0.1:27017/exam-system-dev

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1d
JWT_SECRET=xxxxxxxxxxxxxx
JWT_REFRESH_SECRET=xxxxxxxxxxxxxxxx

CORS_ORIGIN=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=xxxxxxx
SEED_ON_START=true
DOTENV_CONFIG_QUIET=true
ADMIN_SEED_EMAIL=admin
ADMIN_SEED_PASSWORD=123
ADMIN_SEED_MUST_CHANGE_PASSWORD=false

CLOUDINARY_CLOUD_NAME=xxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxx

GOOGLE_SERVICE_ACCOUNT_EMAIL=xxxxxxxxxxxxxxxxxxxx
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\xxxxxxxxxxxxxxxxx\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_BACKUP_FOLDER_ID=xxxxxxxxxxxxxxxxxx
# Khóa mã hóa bản backup (bắt buộc ở production). Sinh: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CẤT BẢN SAO KHÓA Ở NƠI RIÊNG: mất khóa = không khôi phục được bản backup đã mã hóa.
BACKUP_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=xxxxxxxxxxxxxxxxxxxx
#GOOGLE_REFRESH_TOKEN 7 ngày 1 lần và sử dụng lệnh: node src/scripts/get-google-refresh-token.js để lấy mã